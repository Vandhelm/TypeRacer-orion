{
  "permissions": {
    "allow": [
      "Bash(bun test:*)",
      "Bash(bun run test:*)",
      "Bash(bun run typecheck:*)",
      "Bash(bun run lint:*)",
      "Bash(bun run db:up:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git stash:*)",
      "Bash(git merge --no-ff:*)",
      "Bash(git worktree:*)",
      "Bash(git cherry-pick:*)",
      "Bash(bash .claude/hooks/worktree-setup.sh:*)",
      "Bash(git push -u origin feature/:*)",
      "Bash(git push origin feature/:*)",
      "Bash(git push -u origin fix/:*)",
      "Bash(git push origin fix/:*)",
      "Bash(git push -u origin chore/:*)",
      "Bash(git push origin chore/:*)",
      "Bash(git push -u origin test/:*)",
      "Bash(git push origin test/:*)"
    ],
    "deny": [
      "Bash(git push origin dev:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin dev:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "enabledPlugins": {
    "figma@synced": false,
    "design@synced": false,
    "engineering@synced": false,
    "informatica-for-claude-platform@synced": false,
    "pdf-viewer@synced": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/push-guard.sh"
          }
        ]
      }
    ]
  }
}
