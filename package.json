{
  "name": "typeracer-orion",
  "dependencies": {
    "better-auth": "^1.7.20",
    "drizzle-orm": "^0.45.4",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "matter-js": "0.19.0",
    "postgres": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/bun": "latest",
    "@types/matter-js": "^0.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "check:no-js": "files=$(git ls-files '*.js' '*.jsx'); if [ -n \"$files\" ]; then echo \"TECH-02 : fichiers JavaScript dans le dépôt :\"; echo \"$files\"; exit 1; fi",
    "test": "bun test",
    "test:smoke": "bun test ./tests/smoke/app.smoke.ts",
    "build": "bun run build.ts",
    "vercel-build": "if [ \"$VERCEL_ENV\" = production ] || [ \"$VERCEL_ENV\" = preview ]; then bun db/cli.ts migrate; fi && bun run build.ts",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun db/cli.ts migrate",
    "db:seed": "bun db/cli.ts seed",
    "db:reset": "bun db/cli.ts reset"
  }
}
