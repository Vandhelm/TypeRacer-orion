DATABASE_URL=postgres://orion:orion@localhost:5432/orion
BETTER_AUTH_SECRET=change-me-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# OAuth App GitHub — callback : <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Application Discord (OAuth2) — redirect : <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Vercel : les prévisualisations se connectent via la production (plugin oAuthProxy). Même valeur en Production et Preview.
OAUTH_PROXY_SECRET=
# Facultatif : adresse de production inscrite chez GitHub et Discord, si différente du domaine de production Vercel.
OAUTH_PROXY_URL=
