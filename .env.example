DATABASE_URL=postgres://orion:orion@localhost:5432/orion
BETTER_AUTH_SECRET=change-me-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# OAuth App GitHub — callback : <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Application Discord (OAuth2) — redirect : <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Cookie d'invité signé (AUTH-02) ; vide : BETTER_AUTH_SECRET est utilisé. 32 caractères minimum.
GUEST_SESSION_SECRET=
# SALLE-04 et 10 : 1 seulement derrière un seul proxy qui ajoute l'IP du client à la fin de x-forwarded-for (VPS derrière nginx…). Inutile sur Vercel.
TRUST_PROXY=
# Serveur temps réel (TECH-06) : `bun run realtime`, lancé aussi par `bun run dev` à côté de Next.js.
# Secret des tickets de connexion, identique sur le site (Vercel) et le serveur temps réel (Fly.io) ;
# vide : BETTER_AUTH_SECRET est utilisé. 32 caractères minimum.
REALTIME_SECRET=
# Port local du serveur temps réel (PORT reste celui de Next.js).
REALTIME_PORT=3001
# Adresse du serveur donnée aux navigateurs par /api/realtime/ticket (wss://… en production).
REALTIME_PUBLIC_URL=ws://localhost:3001
# Origines des pages autorisées à se connecter, séparées par des virgules ; vide : BETTER_AUTH_URL.
REALTIME_ALLOWED_ORIGINS=
# Le serveur temps réel lit aussi DATABASE_URL (connexion directe, pour LISTEN) : la page salle y suit son salon (SALLE-03 à 09).
