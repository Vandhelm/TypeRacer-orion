DATABASE_URL=postgres://orion:orion@localhost:5432/orion
BETTER_AUTH_SECRET=change-me-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# AUTH-01 : GitHub et Discord. Un fournisseur sans identifiant ET secret n'est pas proposé (normal en local) ;
# en production (NODE_ENV=production), il manque alors : un avertissement [auth] AUTH-01 est écrit au démarrage.
# OAuth App GitHub — callback : <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Application Discord (OAuth2) — redirect : <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Cookie d'invité signé (AUTH-02) ; vide : BETTER_AUTH_SECRET est utilisé. 32 caractères minimum.
GUEST_SESSION_SECRET=
# SALLE-04 et 10 : 1 seulement derrière un seul proxy qui ajoute l'IP du client à la fin de x-forwarded-for (VPS derrière nginx…).
# Inutile sur Vercel (VERCEL) et en `next dev`. Jamais 1 sans vrai proxy : l'IP deviendrait forgeable. `next start` exposé
# directement n'est pas pris en charge : l'IP reste inconnue, et les liens d'invitation sont alors tous refusés.
TRUST_PROXY=
# Serveur temps réel (TECH-06) : `bun run realtime`, lancé aussi par `bun run dev` à côté de Next.js.
# Secret des tickets de connexion, identique sur le site (Vercel) et le serveur temps réel (Fly.io) ;
# vide : BETTER_AUTH_SECRET est utilisé. 32 caractères minimum.
REALTIME_SECRET=
# Port local du serveur temps réel (PORT reste celui de Next.js).
REALTIME_PORT=3001
# Adresse du serveur donnée aux navigateurs par /api/realtime/ticket (wss://… en production).
REALTIME_PUBLIC_URL=ws://localhost:3001
# Origines des pages autorisées à se connecter, séparées par des virgules ; vide : BETTER_AUTH_URL.
REALTIME_ALLOWED_ORIGINS=
# Le serveur temps réel lit aussi DATABASE_URL (connexion directe, pour LISTEN) : la page salle y suit son salon (SALLE-03 à 09).

# Fournies par la plateforme (Bun, Next.js, Vercel, Fly.io) : ne pas les définir ici.
# NODE_ENV : development, production ou test ; `db seed` et `db reset` refusent les données de démo en production.
# PORT : port d'écoute de Next.js, et repli de REALTIME_PORT pour le serveur temps réel.
# VERCEL : définie (1) sur Vercel ; l’IP du client est alors lue dans x-vercel-forwarded-for seulement.
# VERCEL_ENV, VERCEL_URL, VERCEL_BRANCH_URL, VERCEL_PROJECT_PRODUCTION_URL : déploiement Vercel ;
#   donnent l'adresse du site et les origines de confiance quand BETTER_AUTH_URL est vide, et déclenchent la migration au build.
# GITHUB_* (GITHUB_STEP_SUMMARY, GITHUB_SHA, GITHUB_REF_NAME, GITHUB_HEAD_REF) : GitHub Actions, lues par scripts/requirement-tests.ts.

# --- Smoke tests (`bun run test:smoke`, tests/smoke/app.smoke.ts), pas nécessaires pour faire tourner le site ---
# Cible un déploiement existant (en lecture seule) au lieu de lancer `next start` en local ; vide : lancement local.
BASE_URL=
# Base jetable des smoke tests ; vide : DATABASE_URL avec le suffixe _smoke.
SMOKE_DATABASE_URL=
# Compte de test d'un déploiement (avec BASE_URL), pour le test de la photo de profil ; vides : ce test est sauté.
SMOKE_USERNAME=
SMOKE_PASSWORD=
# 1 : réutilise le build `next build` déjà présent (CI) ; vide : reconstruit.
SMOKE_SKIP_BUILD=

# --- Tests de bout en bout (`bun run test:e2e`, Playwright, voir docs/TESTS.md), pas nécessaires pour faire tourner le site ---
# Base jetable, remise à zéro à chaque lancement ; vide : DATABASE_URL avec le suffixe _e2e.
E2E_DATABASE_URL=
# 1 : réutilise le build `next build` déjà présent ; vide : reconstruit.
E2E_SKIP_BUILD=

# --- Outillage des agents (scripts/board.ts), pas nécessaire pour faire tourner le site ---
# Fichier du tableau partagé ; vide : <git-common-dir>/orion-board.json.
# ORION_BOARD=
